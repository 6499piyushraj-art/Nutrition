# Database
DATABASE_PATH=./data/health.db

# Auth — generate a random secret: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECURE=false

# AI Providers (all optional — app works without them, AI food parsing will be disabled)
# Groq: free text parsing — https://console.groq.com/
GROQ_API_KEY=
# Google Gemini: text + image nutrition parsing — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional comma-separated extra keys, tried if the primary key fails (keep server-side only)
GEMINI_API_KEYS=
# Primary Gemini model (optional). The code has seven built-in fallbacks if a model fails.
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated model IDs; built-in defaults are appended if fewer than seven are supplied.
GEMINI_FAILOVER_MODELS=
# Number of independent estimators in the jury (default 5; range 2-5), followed by a separate judge.
GEMINI_JURY_ESTIMATORS=5
# In-memory response-cache TTL in days (default 30; max 365).
GEMINI_CACHE_TTL_DAYS=30
# Anthropic: fallback AI provider — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Food Search — https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
